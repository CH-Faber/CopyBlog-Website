---
import BaseLayout from "@/layouts/BaseLayout.astro"
import BookshelfContent from "@/components/bookshelf-content.astro"
import { getSitePage } from "@/lib/site-pages"

const pageInfo = getSitePage("bookshelf")
const { title, description } = pageInfo
---

<BaseLayout {title} {description}>
  <BookshelfContent heading={pageInfo.heading} subtitle={pageInfo.subtitle} />
</BaseLayout>
