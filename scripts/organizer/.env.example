# 只监听本机，由 Nginx 提供 HTTPS 公网入口
ORGANIZER_HOST=127.0.0.1
ORGANIZER_PORT=3020
ORGANIZER_DB_PATH=/var/lib/faber-organizer/organizer.db
ORGANIZER_ATTACHMENT_DIR=/var/lib/faber-organizer/attachments
ORGANIZER_BACKUP_DIR=/var/lib/faber-organizer/backups
ORGANIZER_PUBLIC_ORIGIN=https://faberhu.top
ORGANIZER_TIMEZONE=Asia/Shanghai
ORGANIZER_SESSION_DAYS=30
ORGANIZER_MAX_UPLOAD_MB=8

# 使用 `faber-organizer hash-password` 从标准输入生成；不要填写明文密码。
ORGANIZER_ADMIN_PASSWORD_HASH=

# 兼容 OpenAI Chat Completions 的外部 AI。密钥只保存在服务器。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# 使用 `faber-organizer generate-vapid` 生成。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@faberhu.top
